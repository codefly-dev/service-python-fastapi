# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# The git commits uv.lock pins (git_source_downloads in the recipe), fetched by
# the caller on its own machine, with its own credentials, before any image
# build, and supplied here as the build context of this name: one bare mirror
# per repository. Without a caller supplying it, the stage is empty and uv
# fetches them from the network as it always did.
FROM scratch AS uvsources

# The builder image — installs the venv via uv, then we copy it into the runtime.
FROM BUILDER_IMAGE as builder

# uv is part of what the recipe has to state. A base image carries whichever uv
# it happened to be built with, so a project written against a newer `[tool.uv]`
# key resolves on the developer's machine and fails inside the builder stage
# with a TOML parse error naming a field that uv there does not know. Copying a
# pinned uv in makes the tool that reads pyproject.toml and uv.lock a declared
# input of the recipe instead of a property of the base image.
COPY --from=UV_IMAGE /uv /usr/local/bin/uv

WORKDIR /app

COPY code/pyproject.toml code/uv.lock ./

# Install deps to a project-local .venv. --frozen installs the locked resolution
# as it stands instead of re-resolving it at build time. --no-editable installs
# workspace members and path sources as packages in the venv rather than links
# to builder-stage sources, which the runtime stage does not carry.
#
# A project whose requires-python the base image's Python does not satisfy gets
# the interpreter uv installs for it, as on the host. It is installed where the
# runtime stage copies it from, so the venv's interpreter exists there too.
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python
#
# With the caller's mirrors, git reads each locked repository from its mirror
# instead of the URL the lock records (uv hands git that URL unchanged), so no
# credential is needed, and a commit missing from the mirror fails here rather
# than prompting for one. The mirror mappings take the first entries of git's
# environment configuration, so they win over an inherited rewrite of the same
# URL, and the entries the environment already carries (GIT_CONFIG_COUNT, read
# as git reads it) move after them, read by name and never evaluated. A count
# git would reject is left as it is, for git to reject as before.
RUN --mount=type=bind,from=uvsources,target=/uvsources \
    if [ -n "$(ls -A /uvsources)" ]; then \
      n=${GIT_CONFIG_COUNT:-0}; n=${n#+}; while [ "${n#0}" != "$n" ] && [ -n "${n#0}" ]; do n=${n#0}; done; \
      case $n in ''|*[!0-9]*) ;; *) \
        i=$n; while [ "$i" -gt 0 ]; do i=$((i-1)); \
          eval "k=\${GIT_CONFIG_KEY_$i}"; eval "v=\${GIT_CONFIG_VALUE_$i}"; \
          export "GIT_CONFIG_KEY_$((i+2))=$k" "GIT_CONFIG_VALUE_$((i+2))=$v"; \
        done; \
        export GIT_CONFIG_COUNT=$((n+2)) GIT_TERMINAL_PROMPT=0 \
          GIT_CONFIG_KEY_0='url.file:///uvsources/c9fa8363b851c2643d648edad1c8c7892904f717385511fe4771422d0817a55e.git.insteadOf' GIT_CONFIG_VALUE_0='https://git.example.invalid/acme/mono' \
          GIT_CONFIG_KEY_1='url.file:///uvsources/d2b987abe743521016c33e82dba28324380629b9d2544f9e5213ee4299a3af6c.git.insteadOf' GIT_CONFIG_VALUE_1='ssh://git@git.example.invalid:2222/acme/tools.git';; \
      esac; \
    fi && \
    mkdir -p /opt/uv/python && uv sync --frozen --no-dev --no-install-project --no-editable


# Runtime
FROM BUILDER_IMAGE as runtime

WORKDIR /app

# UID pinned to match runAsUser in the kustomize Deployment: Kubernetes'
# runAsNonRoot check rejects a container whose image user is non-numeric.
RUN adduser -D -u 1000 appuser
USER appuser

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

COPY --from=builder /opt/uv/python /opt/uv/python
COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}

COPY --chown=appuser service.codefly.yaml .


COPY --chown=appuser code/src code/src




WORKDIR /app/code

# uvicorn's logging configuration and the filter it names (uvicorn_logging.go):
# health probes are dropped from the access log, everything else is as uvicorn
# writes it. The builder writes both into the project before the build.
COPY --chown=appuser code/uvicorn-log-config.json code/codefly_uvicorn_logging.py ./

# Default REST port (overridden by codefly at runtime).
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8080", "--log-config", "uvicorn-log-config.json"]
