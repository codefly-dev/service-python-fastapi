from src.admin.models import Version
from src.admin.version import get_version

# The runtime configuration the app reads, the authority the hop stamps for and
# the client are in tests/conftest.py. Every route but /health and /ready is
# admitted, so a call has to carry the stamp the hop writes for it: "GET /version"
# is the method the hop's HTTP face binds a REST call to.


async def test_version(client, stamp):
    response = await client.get("/version", headers=stamp("GET /version"))
    assert response.status_code == 200

    assert Version.model_validate(response.json()) == get_version()
