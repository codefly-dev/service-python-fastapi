"""Every call this service serves is admitted by the authority's hop, and there
is no way to serve one that is not.

The stamp these tests present is the one the hop writes (tests/conftest.py),
verified by the very ``codefly_hop.Verifier`` the process runs. Keep these
tests: they are what says a route of yours cannot be reached unstamped.
"""

import asyncio
import time

import pytest
from codefly_hop import Replayed
from fastapi import Request

from codefly_hop_entry import app as served
from src import hop
from src.hop import Admission, HopAdmission, LocalReservations
from src.main import app


async def test_a_call_without_a_stamp_is_refused(client):
    response = await client.get("/version")
    assert response.status_code == 401
    assert response.json()["code"] == "stamp_proof"


async def test_a_call_the_hop_stamped_is_admitted(client, stamp):
    response = await client.get("/version", headers=stamp("GET /version"))
    assert response.status_code == 200
    assert response.json()["version"]


async def test_an_admission_is_single_use(client, stamp):
    headers = stamp("GET /version")
    assert (await client.get("/version", headers=headers)).status_code == 200
    replayed = await client.get("/version", headers=headers)
    assert replayed.status_code == 401
    assert replayed.json()["code"] == "stamp_replayed"


async def test_an_admission_signed_for_another_route_is_refused(client, stamp):
    refused = await client.get("/version", headers=stamp("GET /somewhere-else"))
    assert refused.status_code == 401
    assert refused.json()["code"] == "stamp_method"


async def test_an_admission_signed_for_another_module_is_refused(client, stamp):
    refused = await client.get(
        "/version", headers=stamp("GET /version", audience="another-module")
    )
    assert refused.status_code == 401
    assert refused.json()["code"] == "stamp_audience"


async def test_a_path_no_route_claims_is_refused_rather_than_answered(client):
    # The admission runs before routing, so an unstamped call to a path this app
    # does not serve never reaches the router.
    refused = await client.get("/not-a-route")
    assert refused.status_code == 401


async def test_a_route_reads_who_the_call_is_for(client, stamp):
    # The verified identity, which is the only place a route should learn who a
    # call is for. Never a header: the hop writes those, and only the verifier
    # has checked that they match the Work Context it authenticated.
    @app.get("/who", include_in_schema=False)
    async def who(request: Request):
        return {"tenant": request.state.codefly_identity.tenant}

    try:
        response = await client.get("/who", headers=stamp("GET /who"))
        assert response.status_code == 200
        assert response.json()["tenant"] == "fixture-tenant"
    finally:
        app.router.routes = [
            route
            for route in app.router.routes
            if getattr(route, "path", None) != "/who"
        ]


def test_the_wrap_is_the_agents_entry_and_not_this_services_source():
    # Where the admission is, which is as much of the rule as that it is there:
    # codefly_hop_entry.py is the agent's file, rewritten on every start, and it
    # wraps this service's application from outside. Nothing under src/ installs
    # the wrap, so no edit under src/ removes it — and installing it here as
    # well would make every call look replayed, because an admission is
    # single-use and would then be verified twice.
    assert isinstance(served, HopAdmission)
    assert served.app is app
    assert not any(
        getattr(middleware, "cls", None) is HopAdmission
        for middleware in app.user_middleware
    )


async def test_a_browser_preflight_is_answered_rather_than_refused(client):
    # A preflight is not a call: the browser sends it before the call it is
    # asking about, it carries no Work Context — the hop signs no admission for
    # one — and the app's CORS layer answers it with headers alone. Refusing it
    # would make every browser call fail at the preflight instead of at the
    # call, which is not the hop's decision to report.
    answered = await client.options(
        "/version",
        headers={
            "Origin": "https://caller.example",
            "Access-Control-Request-Method": "GET",
        },
    )
    assert answered.status_code == 200


async def test_an_options_call_that_is_not_a_preflight_is_admitted_like_any_other(
    client,
):
    refused = await client.options("/version")
    assert refused.status_code == 401
    assert refused.json()["code"] == "stamp_proof"


async def test_health_and_ready_are_open(client):
    assert (await client.get("/health")).status_code == 200
    ready = await client.get("/ready")
    assert ready.status_code == 200
    assert ready.json()["ready"] is True


async def test_ready_withdraws_without_trusted_keys(client, admission):
    admission.release()
    withdrawn = await client.get("/ready")
    assert withdrawn.status_code == 503
    assert withdrawn.json()["reason"] == "keys_unavailable"


async def test_a_call_is_refused_when_no_verifier_is_bound(client, admission, stamp):
    headers = stamp("GET /version")
    admission.release()
    refused = await client.get("/version", headers=headers)
    assert refused.status_code == 401
    assert refused.json()["code"] == "configuration"


async def test_a_reservation_is_forgotten_once_its_retention_passes():
    # A developer run reserves in this process, and what it reserves has to be
    # evictable: holding every nonce it ever saw would grow for as long as the
    # run lasts. A reservation only has to outlive the admission it belongs to —
    # past that the verifier refuses the admission as expired before its nonce
    # is looked up at all — so forgetting it there is not a replay hole.
    reservations = LocalReservations()
    retain_until = time.time() + 0.05
    await reservations.reserve_async("nonce", retain_until)
    with pytest.raises(Replayed):
        await reservations.reserve_async("nonce", retain_until)

    await asyncio.sleep(0.06)
    await reservations.reserve_async("nonce", time.time() + 30)


async def test_the_service_refuses_to_start_without_the_authority_endpoint(monkeypatch):
    monkeypatch.delenv(
        "CODEFLY__WORKSPACE_CONFIGURATION__AUTHORITY__ENDPOINT", raising=False
    )
    with pytest.raises(RuntimeError, match="authority/endpoint"):
        await hop.build(Admission())


async def test_the_service_refuses_to_start_without_its_audience(monkeypatch):
    monkeypatch.setenv(
        "CODEFLY__WORKSPACE_CONFIGURATION__AUTHORITY__ENDPOINT", "127.0.0.1:1"
    )
    monkeypatch.delenv("CODEFLY__MODULE", raising=False)
    with pytest.raises(RuntimeError, match="CODEFLY__MODULE"):
        await hop.build(Admission())


async def test_the_service_refuses_to_start_without_a_shared_replay_store(monkeypatch):
    # Outside the run named exactly local, each single-use admission has to be
    # reserved somewhere every replica shares.
    monkeypatch.setenv(
        "CODEFLY__WORKSPACE_CONFIGURATION__AUTHORITY__ENDPOINT", "127.0.0.1:1"
    )
    monkeypatch.setenv("CODEFLY__ENVIRONMENT", "production")
    monkeypatch.delenv(
        "CODEFLY__WORKSPACE_SECRET_CONFIGURATION__HOP__REPLAY_CONNECTION", raising=False
    )
    with pytest.raises(RuntimeError, match="hop/replay-connection"):
        await hop.build(Admission())
