[project]
name = "base"
version = "0.0.0"
description = ""
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.109.0",
    "uvicorn>=0.25.0",
    "codefly-sdk>=0.0.14",
    "pydantic>=2.9.2",
    # The authority's Python client, pinned by commit: every call this service
    # serves is admitted through codefly_hop.Verifier (src/hop.py), and no
    # dependency carrying a verifier is ever resolved by name from a public
    # index. Move the commit deliberately, never with a range.
    "authority-client @ git+https://github.com/codefly-dev/authority@19ad6b641f9dafda1294ee277f6f6c7c1dd2db51#subdirectory=libraries/authority-client/python",
    # The driver codefly_hop.replaypg reserves each single-use admission with,
    # in the Postgres hop/replay-connection names. Required wherever the run is
    # not the one named local, which reserves in the process instead.
    "asyncpg>=0.30.0",
{{- if .GRPCEnabled }}
    "grpcio>=1.60.0",
    "grpcio-health-checking>=1.60.0",
    "protobuf>=4.25.0",
{{- end }}
]

[dependency-groups]
dev = [
    "pytest>=8.2.0",
    "httpx>=0.27.0",
    "pytest-asyncio>=0.23.6",
    "codefly-cli>=0.0.19",
    "ruff>=0.6.0",
{{- if .GRPCEnabled }}
    "grpcio-tools>=1.60.0",
{{- end }}
]

[tool.uv]
package = false
# A CONSTRAINT, not a dependency: it bounds a version only if something
# else pulls the package in. multidict 7.1.0 (PyPI, 2026-10-09) shipped
# without manylinux wheels, so `uv sync` in the Debian runtime had nothing
# to install and no compiler to build it -- every fresh service failed at
# Create. Lift it once a 7.1.x with manylinux wheels exists; the durable
# fix is a uv.lock shipped with this template so a create never resolves
# whatever PyPI published an hour ago.
constraint-dependencies = ["multidict<7.1"]

[tool.pytest.ini_options]
# "." — not "src" — so the `from src.X` imports in the scaffolded tests
# resolve. src/ ships with an __init__.py making it a proper package.
pythonpath = ["."]
testpaths = ["tests"]
# pytest-asyncio 1.x needs an explicit mode. "auto" picks up async def
# tests without needing @pytest.mark.asyncio on every one; keeps the
# boilerplate low for scaffolded services.
asyncio_mode = "auto"
