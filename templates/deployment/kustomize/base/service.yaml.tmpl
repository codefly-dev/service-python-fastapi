apiVersion: v1
kind: Service
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: {{ .Namespace }}
spec:
  selector:
    app: {{ .Service.Name.DNSCase}}
  ports:
    - protocol: TCP
      name: http-port
      port: 8080
      targetPort: 8080
{{- if .Deployment.Parameters.GRPCEnabled }}
    - protocol: TCP
      name: grpc-port
      port: {{ .Deployment.Parameters.GRPCPort }}
      targetPort: {{ .Deployment.Parameters.GRPCPort }}
{{- end }}
{{- if .Deployment.Parameters.ConnectEnabled }}
    - protocol: TCP
      name: connect-port
      # Connect and gRPC-Web are HTTP/1.1 on this listener (gRPC is HTTP/2 with
      # prior knowledge, relayed to the gRPC port). An L7 hop that upgraded a
      # Connect call to HTTP/2 would reach the relay, which answers gRPC only,
      # so the port declares http.
      appProtocol: http
      port: {{ .Deployment.Parameters.ConnectPort }}
      targetPort: {{ .Deployment.Parameters.ConnectPort }}
{{- end }}
